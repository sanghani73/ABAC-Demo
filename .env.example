# MongoDB Atlas connection string (M10+ with Atlas Vector Search)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority

# API key for the MongoDB-hosted Voyage embeddings endpoint
# (https://ai.mongodb.com/v1/multimodalembeddings) — used by the app
# (lib/embeddings.ts) to embed queries and by the seed script to embed
# report bodies and media items. Generate one from your MongoDB / Atlas
# account.
#
# Offline note: `npm run seed` embeds the sample search queries (see
# lib/sampleQueries.ts) into the `queryEmbeddings` collection, so after a
# seed with network access the demo can be run offline — provided you only
# use the pre-baked pill queries. An off-list, hand-typed query offline will
# surface a clear "cache miss + Voyage unreachable" error.
VOYAGE_API_KEY=...

# Embedding model. Defaults to voyage-multimodal-3.5 (1024 dims) — used for
# both report bodies (text-only) and media items (text + image), so the
# reports and media indexes share a single vector space.
# Supported on the /multimodalembeddings endpoint:
#   voyage-multimodal-3.5, voyage-multimodal-3
# Do NOT set to a text-only model (voyage-3.5 etc.) — the demo posts to the
# multimodal endpoint, which only accepts the multimodal model family.
VOYAGE_MODEL=voyage-multimodal-3.5

# Database and collection names
MONGODB_DB=abac_demo
MONGODB_REPORTS=reports
MONGODB_POLICIES=policies
MONGODB_USERS=users
MONGODB_MEDIA_INDEX=media_index
# Offline cache of Voyage vectors for the sample search-page / chat pills.
# Populated by scripts/seed.ts; served by lib/queries.ts before falling back
# to a live Voyage call.
# MONGODB_QUERY_EMBEDDINGS=queryEmbeddings
MONGODB_VECTOR_INDEX=reports_vector
MONGODB_MEDIA_VECTOR_INDEX=media_vector

# --- LLM chat (RAG over ABAC-filtered retrieval) ---
# Grove gateway base URL. Routes openai/* and anthropic/* under one key.
GROVE_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod
# Key issued by your Grove tenancy. The chat route picks the OpenAI vs
# Anthropic path based on the model id prefix (gpt-* → OpenAI Responses API,
# claude-* → Anthropic Messages API).
GROVE_API_KEY=...
# Comma-separated list of model ids surfaced in the chat drawer's model
# dropdown. Pick two that both support vision so the multimodal RAG demo
# works regardless of which is selected.
GROVE_CHAT_MODELS=claude-sonnet-4-6,gpt-5.5
